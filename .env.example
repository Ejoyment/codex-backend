# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration (Using Gmail as example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=CODEX INC <noreply@codexinc.com>

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:5500

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PROFESSIONAL_PRICE_ID=price_your_professional_monthly_price_id
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=price_your_professional_yearly_price_id
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id

# Paystack Payment Configuration (Nigeria)
# Get keys from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# Flutterwave Payment Configuration (Nigeria)
# Get keys from: https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Backend URL
BACKEND_URL=http://localhost:3000

# GitHub Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Slack Integration
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# Notion Integration
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret

# Figma Integration
FIGMA_CLIENT_ID=your_figma_client_id
FIGMA_CLIENT_SECRET=your_figma_client_secret

# Discord Integration
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# AI Pair Programming
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=mixtral-8x7b-32768
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-tiny
AI_MODEL=gemini-2.0-flash-exp
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.7

# BYOM - Bring Your Own Model (Phase 2)
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_ENABLED=false
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model
LM_STUDIO_ENABLED=false
LOCAL_PRIVACY_MODE=false
AI_RATE_LIMIT=60

# VS Code Integration (Optional)
VSCODE_EXTENSION_TOKEN=your_vscode_extension_token

# Demo Agent Configuration
DEMO_AGENT_EMAIL=agent@buildershq.com
DEMO_AGENT_PASSWORD=change-me-in-production
DEMO_AGENT_NAME=Demo Support Agent
# Deployment Infrastructure (Hetzner VPS + Docker + Traefik)
# These allow the backend to spin up real Docker containers for user deployments.
# The SSH private key can be set via DEPLOY_SSH_KEY (paste full key, supports multi-line in Render)
# Or via DEPLOY_SSH_KEY_FILE (path to key file, useful for local dev / Docker secrets)
DEPLOY_SSH_HOST=62.238.115.127
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=deployer
# DEPLOY_SSH_KEY — paste the full private key here (supports multi-line)
DEPLOY_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\nyour-key-here\n-----END OPENSSH PRIVATE KEY-----
# DEPLOY_SSH_KEY_FILE — alternative: path to a key file on disk
# The domain under which deployments get subdomains (e.g. my-app.buildrshq.dev)
DEPLOY_DOMAIN=buildrshq.dev
# Where project files are stored on the VPS (optional, default: /opt/deployments)
DEPLOY_ROOT=~/deployments

# Phase 3 — Actionable Multiplayer & Global Runtime
# Ephemeral debug rooms: TTL + idle timeout (ms)
DEBUG_ROOM_TTL_MS=7200000
DEBUG_ROOM_IDLE_MS=1800000
# WebRTC TURN relay (used when P2P is blocked; also set NEXT_PUBLIC_TURN_URL on frontend)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
# Cloud container fallback for Tier 2 runtime
CLOUD_RUNTIME_URL=
# Flutterwave webhook verification hash (verif-hash header)
FLUTTERWAVE_WEBHOOK_HASH=
# Phase 3 — Tiered Pricing Structure
TIER_PRICING_DEVELOPER_MONTHLY=0
TIER_PRICING_PRO_MONTHLY=20
TIER_PRICING_PRO_YEARLY=16
TIER_PRICING_PRO_PLUS_MONTHLY=60
TIER_PRICING_PRO_PLUS_YEARLY=48
TIER_PRICING_TEAM_STANDARD_MONTHLY=40
TIER_PRICING_TEAM_STANDARD_YEARLY=32
TIER_PRICING_TEAM_PREMIUM_MONTHLY=120
TIER_PRICING_TEAM_PREMIUM_YEARLY=96
CREDIT_POOL_PRO_MONTHLY=20
CREDIT_POOL_PRO_PLUS_MONTHLY=70
CREDIT_POOL_TEAM_STANDARD_PER_SEAT=40
CREDIT_POOL_TEAM_PREMIUM_PER_SEAT=200
CLOUD_COMPUTE_PRO_MONTHLY_HOURS=10
CLOUD_COMPUTE_PRO_PLUS_MONTHLY_HOURS=50
CLOUD_COMPUTE_TEAM_STANDARD_PER_SEAT_HOURS=25
CLOUD_COMPUTE_TEAM_PREMIUM_PER_SEAT_HOURS=120
MAX_CONCURRENT_AGENT_JOBS_PRO=1
MAX_CONCURRENT_AGENT_JOBS_PRO_PLUS=3
MAX_CONCURRENT_AGENT_JOBS_TEAM_STANDARD=2
MAX_CONCURRENT_AGENT_JOBS_TEAM_PREMIUM=5
TASK_TIMEOUT_PRO_MINUTES=15
TASK_TIMEOUT_PRO_PLUS_MINUTES=30
TASK_TIMEOUT_TEAM_STANDARD_MINUTES=30
TASK_TIMEOUT_TEAM_PREMIUM_MINUTES=60
DEBUG_ROOM_HOST_ROOMS_PRO=1
DEBUG_ROOM_HOST_ROOMS_PRO_PLUS=3
DEBUG_ROOM_PARTICIPANTS_PRO=2
DEBUG_ROOM_PARTICIPANTS_PRO_PLUS=4
DEBUG_ROOM_PARTICIPANTS_TEAM_STANDARD=4
DEBUG_ROOM_PARTICIPANTS_TEAM_PREMIUM=8
MAX_ACTIVE_DEPLOYMENTS_PRO=3
MAX_ACTIVE_DEPLOYMENTS_PRO_PLUS=10
MAX_ACTIVE_DEPLOYMENTS_TEAM_STANDARD=20
DEBUG_ROOM_TTL_CLEANUP_INTERVAL=3600000
COOP_COEP_ENABLED=true
CDN_BASE_URL=
EDGE_NODES_JSON={}
ENTITLEMENT_GRACE_PERIOD_DAYS=7
PAY_AS_YOU_GO_ENABLED=true
OVERAGE_GRACE_PERIOD_DAYS=7
