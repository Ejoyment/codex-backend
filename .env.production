# Production Environment Configuration
# Domain: codexincenterprise.online
#
# WARNING: This is a TEMPLATE file for reference only.
# NEVER commit actual secret values to version control.
# Copy this to .env, fill in your real values, and keep .env out of git.

# Server Configuration
PORT=3000
NODE_ENV=production

# MongoDB Configuration
# Replace with your actual MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-your-generated-jwt-secret

# Email Configuration - Resend (Production Ready)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
EMAIL_FROM=CODEX INC <onboarding@resend.dev>

# Legacy Gmail SMTP (Backup - not used)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Production URLs
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://yourdomain.com

# Google OAuth (Update callback URL in Google Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://yourdomain.com/auth/facebook/callback

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PROFESSIONAL_PRICE_ID=price_xxxxxxxxxxxxxxxxx
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=price_xxxxxxxxxxxxxxxxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxxxxxxxxxxxxxxxx

# Paystack Payment Configuration (Nigeria)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flutterwave Payment Configuration (Nigeria)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id.slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# Notion OAuth
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Figma OAuth
FIGMA_CLIENT_ID=your-figma-client-id
FIGMA_CLIENT_SECRET=your-figma-client-secret

# AI Pair Programming - Groq (FREE and Fast)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# AI Configuration
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.7
AI_MODEL=gemini-1.5-flash

# Optional: Other AI Providers (if needed)
GEMINI_API_KEY=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-tiny
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2